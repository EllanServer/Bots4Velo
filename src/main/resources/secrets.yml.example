# Copy this file to plugins/bots4velo/secrets.yml. Do not commit the copied file.
# Refer to a key with bots.<id>.password-secret in config.yml.
# The backend-control shared key is read from runtime.backend-control.secret or
# its preferred secret-env environment variable, not from this passwords map.
passwords:
  iron-farm-01: "replace-with-a-strong-password"
